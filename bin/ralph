#!/usr/bin/env bash
# Ralph loop: run Claude Code on prompts/ralph.md, one todo per run.
# Starts another run only when the last one wrote .ralph/continue.
set -euo pipefail

PROMPT_FILE="${1:-prompts/ralph.md}"
STATE_DIR=".ralph"
CONTINUE_FILE="$STATE_DIR/continue"

# Edit files and run local checks; no commits, installs or network.
ALLOWED_TOOLS=(
  Read Edit Write Glob Grep
  "Bash(npm run *)" "Bash(npm test*)" "Bash(npx vitest *)" "Bash(npx tsc *)"
  "Bash(git status*)" "Bash(git diff*)"
)

agent_pid=""

cleanup() {
  trap - SIGINT SIGTERM
  echo ""
  echo "==== shutting down ===="
  if [[ -n "$agent_pid" ]]; then
    kill "$agent_pid" 2>/dev/null || true
    wait "$agent_pid" 2>/dev/null || true
  fi
  exit "$1"
}

trap 'cleanup 130' SIGINT
trap 'cleanup 143' SIGTERM

if ! command -v claude >/dev/null 2>&1; then
  echo "error: claude CLI not found on PATH" >&2
  exit 127
fi

if [[ ! -f "$PROMPT_FILE" ]]; then
  echo "error: prompt file not found: $PROMPT_FILE" >&2
  echo "usage: $0 [prompt-file]" >&2
  exit 1
fi

mkdir -p "$STATE_DIR"

while true; do
  rm -f "$CONTINUE_FILE"

  echo "==== starting iteration ===="
  claude -p --allowedTools "${ALLOWED_TOOLS[@]}" < "$PROMPT_FILE" &
  agent_pid=$!
  set +e
  wait "$agent_pid"
  status=$?
  set -e
  if [[ "$status" -ne 0 ]]; then
    echo "==== claude exited with status $status; stopping ====" >&2
    exit "$status"
  fi

  if [[ ! -f "$CONTINUE_FILE" ]]; then
    echo "==== no continue signal; stopping ===="
    exit 0
  fi

  echo "==== continue signal found; starting next iteration ===="
done
